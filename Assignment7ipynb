    "\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "df = pd.read_csv(r\"C:\\Users\\jyotm\\Downloads\\Titanic-Dataset.csv\")\n",
    "\n",
    "\n",
    "print(\"First 5 rows of the Titanic dataset:\")\n",
    "display(df.head())  # Use print(df.head()) if running outside Jupyter Notebook\n",
    "\n",
    "print(\"\\nDataset info:\")\n",
    "print(df.info())\n",
    "\n",
    "\n",
    "plot_df = df.dropna(subset=[\"Age\", \"Fare\"])\n",
    "\n",
    "\n",
    "avg_fare_by_class = plot_df.groupby(\"Pclass\")[\"Fare\"].mean()\n",
    "\n",
    "plt.figure(figsize=(7, 4))\n",
    "plt.plot(avg_fare_by_class.index, avg_fare_by_class.values, marker=\"o\", linestyle=\"-\", color=\"b\")\n",
    "plt.title(\"Line Plot: Average Fare by Passenger Class\")\n",
    "plt.xlabel(\"Passenger Class (Pclass)\")\n",
    "plt.ylabel(\"Average Fare\")\n",
    "plt.xticks([1, 2, 3])\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(7, 4))\n",
    "plt.bar(avg_fare_by_class.index.astype(str), avg_fare_by_class.values, color=\"teal\")\n",
    "plt.title(\"Bar Plot: Average Fare by Passenger Class\")\n",
    "plt.xlabel(\"Passenger Class (Pclass)\")\n",
    "plt.ylabel(\"Average Fare\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "plt.figure(figsize=(7, 4))\n",
    "plt.scatter(plot_df[\"Age\"], plot_df[\"Fare\"], alpha=0.6, color=\"coral\")\n",
    "plt.title(\"Scatter Plot: Age vs. Fare\")\n",
    "plt.xlabel(\"Age\")\n",
    "plt.ylabel(\"Fare\")\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "corr_matrix = df.corr(numeric_only=True)\n",
    "print(\"\\nCorrelation Matrix:\")\n",
    "print(corr_matrix)\n",
    "\n",
    "\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.heatmap(corr_matrix, annot=True, cmap=\"coolwarm\", fmt=\".2f\", linewidths=0.5)\n",
    "plt.title(\"Heatmap: Correlation Matrix of Titanic Numerical Features\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
