    "import re\n",
    "\n",
    "string = input(\"Enter a string: \")\n",
    "\n",
    "pattern = \"^[a-zA-Z0-9]+$\"\n",
    "\n",
    "if re.fullmatch(pattern, string):\n",
    "    print(\"Valid String\")\n",
    "else:\n",
    "    print(\"Invalid String\")"
   ]
